<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BoardGamerApp.Views"
             x:Class="BoardGamerApp.Views.MainPage"
             BackgroundColor="#F8F5F0">

       <Grid RowDefinitions="Auto,*,80">

              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Padding="30,30,30,0"
                                          Spacing="25">

                            <Label Text="Kommende Termine"
                                   Style="{StaticResource Headline}"
                                   FontSize="18"
                                   SemanticProperties.HeadingLevel="Level1"/>

                            <!-- Sichtbar nur wenn es mindestens 1 zukünftigen Termin gibt -->
                            <CollectionView ItemsSource="{Binding Top3UpcomingEvents}"
                                            IsVisible="{Binding HasUpcomingEvents}">
                                   <CollectionView.ItemTemplate>
                                          <DataTemplate>
                                            <Border StrokeShape="RoundRectangle 12"
                                                        Padding="15"
                                                        Margin="0,0,0,15"
                                                        BackgroundColor="White"
                                                        >

                                                        <Border.GestureRecognizers>
                                                               <TapGestureRecognizer Tapped="OnGamesClicked"/>
                                                        </Border.GestureRecognizers>

                                                        <VerticalStackLayout Spacing="6">
                                                               <Label Text="{Binding DisplayDate}"
                                                                      FontAttributes="Bold"
                                                                      FontSize="16"
                                                                      TextColor="#0F172A"/>

                                                               <Label Text="{Binding Location, StringFormat='Ort: {0}'}"
                                                                      FontSize="14"
                                                                      TextColor="#334155"/>

                                                               <Label Text="{Binding Game, StringFormat='Spiel: {0}'}"
                                                                      FontSize="14"
                                                                      TextColor="#334155"/>

                                                               <Label Text="{Binding Host, StringFormat='Ausrichter: {0}'}"
                                                                      FontSize="14"
                                                                      TextColor="#1E3A8A"
                                                                      FontAttributes="Bold"/>
                                                        </VerticalStackLayout>

                                                 </Border>
                                          </DataTemplate>
                                   </CollectionView.ItemTemplate>
                            </CollectionView>


                     </VerticalStackLayout>
              </ScrollView>


              <!-- Footer Navigation -->
              <Grid Grid.Row="2"
                    BackgroundColor="#F8F5F0"
                    Padding="20,10"
                    ColumnDefinitions="*,Auto,*"
                    VerticalOptions="End">

                     <!-- Termine -->
                     <VerticalStackLayout Grid.Column="0"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">

                            <VerticalStackLayout.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnEventClicked"/>
                            </VerticalStackLayout.GestureRecognizers>

                            <Image Source="calender_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"/>

                            <Label Text="Termine"
                                   FontSize="12"
                                   TextColor="#8B5E3C"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <!-- Plus Button -->
                     <Frame Grid.Column="1"
                            WidthRequest="60"
                            HeightRequest="60"
                            CornerRadius="30"
                            BackgroundColor="#8B5E3C"
                            HasShadow="True"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">

                            <Frame.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnMessageClicked"/>
                            </Frame.GestureRecognizers>

                            <Image Source="envelope_icon.png"
                                   HeightRequest="28"
                                   WidthRequest="28"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                     </Frame>

                     <!-- Gruppe -->
                     <VerticalStackLayout Grid.Column="2"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">

                            <VerticalStackLayout.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnEventClicked"/>
                            </VerticalStackLayout.GestureRecognizers>

                            <Image Source="group_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"/>

                            <Label Text="Gruppe"
                                   FontSize="12"
                                   TextColor="#8B5E3C"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>
              </Grid>

       </Grid>
</ContentPage>
