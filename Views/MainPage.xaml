<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BoardGamerApp.Views.MainPage"
             BackgroundColor="#F8F5F0">

    <Grid RowDefinitions="Auto,*,80">

        <!-- Hauptinhalt -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="30,0"
                                 Spacing="25">

                <Label Text="Nächster Termin"
                       Style="{StaticResource Headline}"
                       FontSize="18"
                       SemanticProperties.HeadingLevel="Level1"/>

                <Border StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 12">

                    <Border.GestureRecognizers>
                        <!--Durch dazugehörige OnxxxxClicked-Methode ersetzen-->
                        <TapGestureRecognizer Tapped="OnEventClicked"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Padding="15"
                                         Spacing="6">
                        <Label Text="Freitag, 12. Juni 2026 – 19:00 Uhr"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#0F172A"/>

                        <Label Text="Ort: Annastraße 5, 12345 Musterstadt"
                               FontSize="14"
                               TextColor="#334155"/>

                        <Label Text="Spiel: Catan"
                               FontSize="14"
                               TextColor="#334155"/>

                        <Label Text="Ausrichter: Anna"
                               FontSize="14"
                               TextColor="#1E3A8A"
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Vergangener Termin"
                       Style="{StaticResource Headline}"
                       FontSize="18"
                       SemanticProperties.HeadingLevel="Level1"/>

                <Border StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 12"
                        Padding="12"
                        Margin="0,6,0,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRatingClicked"/>
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          VerticalOptions="Center">

                        <!-- Datumskreis -->
                        <Frame Grid.Column="0"
                               WidthRequest="50"
                               HeightRequest="50"
                               CornerRadius="25"
                               BackgroundColor="#EDE6DD"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HasShadow="False">
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="0">
                                <Label Text="Mai"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#7C6A58"
                                       HorizontalOptions="Center"/>
                                <Label Text="10"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#7C6A58"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Termintext -->
                        <VerticalStackLayout Grid.Column="1"
                                             Padding="10,0"
                                             VerticalOptions="Center">
                            <Label Text="Sonntag, 10. Mai"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#3B2E25"/>
                            <Label Text="Bernd K. · Beethovenstr. 4"
                                   FontSize="14"
                                   TextColor="#7C6A58"/>
                        </VerticalStackLayout>

                        <!-- Bewertet-Badge -->
                        <Frame Grid.Column="2"
                               Padding="10,4"
                               CornerRadius="12"
                               BackgroundColor="#EDE6DD"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
                               HasShadow="False">
                            <Label Text="Bewertet"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#7C6A58"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer Navigation -->
        <Grid Grid.Row="2"
              BackgroundColor="#F8F5F0"
              Padding="20,10"
              ColumnDefinitions="*,Auto,*"
              VerticalOptions="End">

            <!-- Termine -->
            <VerticalStackLayout Grid.Column="0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEventClicked"/>
                </VerticalStackLayout.GestureRecognizers>

                <Image Source="calender_icon.png"
                       HeightRequest="24"
                       WidthRequest="24"/>

                <Label Text="Termine"
                       FontSize="12"
                       TextColor="#8B5E3C"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Plus Button -->
            <Frame Grid.Column="1"
                   WidthRequest="60"
                   HeightRequest="60"
                   CornerRadius="30"
                   BackgroundColor="#8B5E3C"
                   HasShadow="True"
                   VerticalOptions="Center"
                   HorizontalOptions="Center">

                <Frame.GestureRecognizers>
                    <!--Durch dazugehörige OnxxxxClicked-Methode ersetzen-->
                    <TapGestureRecognizer Tapped="OnEventClicked"/>
                </Frame.GestureRecognizers>

                <Image Source="plus_icon.png"
                       HeightRequest="28"
                       WidthRequest="28"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
            </Frame>

            <!-- Gruppe -->
            <VerticalStackLayout Grid.Column="2"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <!--Durch dazugehörige OnxxxxClicked-Methode ersetzen-->
                    <TapGestureRecognizer Tapped="OnEventClicked"/>
                </VerticalStackLayout.GestureRecognizers>

                <Image Source="group_icon.png"
                       HeightRequest="24"
                       WidthRequest="24"/>

                <Label Text="Gruppe"
                       FontSize="12"
                       TextColor="#8B5E3C"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>


