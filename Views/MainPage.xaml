<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BoardGamerApp.Views"
             x:Class="BoardGamerApp.Views.MainPage"
             BackgroundColor="#F8F5F0">

       <Grid RowDefinitions="Auto,*,80">

              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Padding="30,30,30,0"
                                          Spacing="25">

                            <!-- Kleine Terminvorschau auf der Startseite. MainPage bekommt (genau
                                 wie EventPage) ein EventViewModel per Dependency Injection - da
                                 es als "Transient" registriert ist (siehe MauiProgram.cs), ist das
                                 aber ein EIGENES Objekt, nicht dieselbe Instanz wie auf EventPage.
                                 Beide laden also unabhängig voneinander aus derselben Datenbank,
                                 hier zeigen wir nur die nächsten 3 Termine (Top3UpcomingGameNights). -->
                            <Label Text="Kommende Termine"
                                   Style="{StaticResource Headline}"
                                   FontSize="18"
                                   SemanticProperties.HeadingLevel="Level1"/>

                            <!-- Sichtbar nur wenn es mindestens 1 zukünftigen Termin gibt -->
                            <CollectionView ItemsSource="{Binding Top3UpcomingGameNights}"
                                            IsVisible="{Binding HasUpcomingEvents}">
                                   <CollectionView.ItemTemplate>
                                          <DataTemplate>
                                            <!-- StrokeThickness/Stroke sind hier bewusst schon vorbelegt (auch wenn
                                                 "Transparent" unsichtbar ist): der DataTrigger unten ändert nur die
                                                 FARBE, nicht die Dicke - die muss also von Anfang an gesetzt sein,
                                                 sonst hätte der Rahmen keine Fläche zum Einfärben. -->
                                            <Border StrokeShape="RoundRectangle 12"
                                                        Padding="15"
                                                        Margin="0,0,0,15"
                                                        BackgroundColor="White"
                                                        Stroke="Transparent"
                                                        StrokeThickness="2"
                                                        >

                                                        <!-- Hebt GENAU den chronologisch nächsten Termin optisch hervor:
                                                             IsNextUpcoming wird von EventViewModel.RecomputeNextUpcoming()
                                                             für immer nur einen Termin auf true gesetzt. Ein DataTrigger
                                                             ändert dafür rein deklarativ (ohne Converter/Code-Behind)
                                                             Hintergrund- und Rahmenfarbe der Karte, sobald die gebundene
                                                             Bedingung zutrifft. -->
                                                        <Border.Triggers>
                                                               <DataTrigger TargetType="Border"
                                                                            Binding="{Binding IsNextUpcoming}"
                                                                            Value="True">
                                                                      <Setter Property="BackgroundColor" Value="#FFF3D6"/>
                                                                      <Setter Property="Stroke" Value="#8B5E3C"/>
                                                               </DataTrigger>
                                                        </Border.Triggers>

                                                        <!-- Tippen auf einen Termin springt zur EventPage (Terminverwaltung) -
                                                             dort kann der Termin dann bearbeitet werden (siehe
                                                             EventPage.xaml.cs, OnEditEventClicked). -->
                                                        <Border.GestureRecognizers>
                                                               <TapGestureRecognizer Tapped="OnEventPreviewClicked"/>
                                                        </Border.GestureRecognizers>

                                                        <VerticalStackLayout Spacing="6">

                                                               <!-- "Nächster Termin"-Badge: nur bei genau der einen
                                                                    hervorgehobenen Karte sichtbar (IsNextUpcoming ist ein
                                                                    bool, dafür reicht direktes Binding an IsVisible ohne
                                                                    Converter). -->
                                                               <Label Text="★ Nächster Termin"
                                                                      FontSize="12"
                                                                      FontAttributes="Bold"
                                                                      TextColor="#8B5E3C"
                                                                      IsVisible="{Binding IsNextUpcoming}"/>

                                                               <!-- Gruppenname (z. B. "Mittwochsrunde"), aufgelöst über
                                                                    GroupId -> gaming_groups (siehe EventViewModel.ApplyDisplayNames). -->
                                                               <Label Text="{Binding GroupName, StringFormat='{0}'}"
                                                                      FontSize="12"
                                                                      FontAttributes="Bold"
                                                                      TextColor="#8B5E3C"
                                                                      IsVisible="{Binding GroupName, Converter={StaticResource StringToBoolConverter}}"/>

                                                               <Label Text="{Binding ScheduledAt, Converter={StaticResource IsoToDisplayDateConverter}}"
                                                                      FontAttributes="Bold"
                                                                      FontSize="16"
                                                                      TextColor="#0F172A"/>

                                                               <Label Text="{Binding LocationName, StringFormat='Ort: {0}'}"
                                                                      FontSize="14"
                                                                      TextColor="#334155"
                                                                      IsVisible="{Binding LocationName, Converter={StaticResource StringToBoolConverter}}"/>

                                                               <Label Text="{Binding GameName, StringFormat='Spiel: {0}'}"
                                                                      FontSize="14"
                                                                      TextColor="#334155"
                                                                      IsVisible="{Binding GameName, Converter={StaticResource StringToBoolConverter}}"/>
                                                                      <Border BackgroundColor="#FFF3D8"
                                                                        Stroke="#B87945"
                                                                        StrokeThickness="1"
                                                                        Padding="8,5"
                                                                        Margin="0,4,0,0"
                                                                        StrokeShape="RoundRectangle 10"
                                                                        IsVisible="{Binding HasTopVotedGame}">

                                                                        <Label Text="{Binding TopVotedGameDisplayText}"
                                                                        FontSize="13"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#8B5E3C" />

                                                                       </Border>
                                    <Label Text="{Binding HostName, StringFormat='Ausrichter: {0}'}"
                                                                      FontSize="14"
                                                                      TextColor="#1E3A8A"
                                                                      FontAttributes="Bold"
                                                                      IsVisible="{Binding HostName, Converter={StaticResource StringToBoolConverter}}"/>
                                                        </VerticalStackLayout>

                                                 </Border>
                                          </DataTemplate>
                                   </CollectionView.ItemTemplate>
                            </CollectionView>


                     </VerticalStackLayout>
              </ScrollView>


              <!-- Footer Navigation -->
              <Grid Grid.Row="2"
                    BackgroundColor="#F8F5F0"
                    Padding="20,10"
                    ColumnDefinitions="*,Auto,*"
                    VerticalOptions="End">

                     <!-- Termine -->
                     <VerticalStackLayout Grid.Column="0"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">

                            <VerticalStackLayout.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnEventClicked"/>
                            </VerticalStackLayout.GestureRecognizers>

                            <Image Source="calender_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"/>

                            <Label Text="Termine"
                                   FontSize="12"
                                   TextColor="#8B5E3C"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <!-- Plus Button -->
                     <Frame Grid.Column="1"
                            WidthRequest="60"
                            HeightRequest="60"
                            CornerRadius="30"
                            BackgroundColor="#8B5E3C"
                            HasShadow="True"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">

                            <Frame.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnMessageClicked"/>
                            </Frame.GestureRecognizers>

                            <Image Source="envelope_icon.png"
                                   HeightRequest="28"
                                   WidthRequest="28"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                     </Frame>

            <!-- Gruppe -->
            <VerticalStackLayout Grid.Column="2"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
            <!-- OnClick Methode für Gruppenansicht -->
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGroupClicked"/>
                </VerticalStackLayout.GestureRecognizers>

                            <Image Source="group_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"/>

                            <Label Text="Gruppe"
                                   FontSize="12"
                                   TextColor="#8B5E3C"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>
              </Grid>

       </Grid>
</ContentPage>
