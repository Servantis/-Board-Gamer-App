<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BoardGamerApp.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Nächster Spieleabend"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"/>

            <Frame CornerRadius="12"
                   Padding="15"
                   BackgroundColor="White"
                   HasShadow="True">

                <VerticalStackLayout Spacing="6">

                    <Label Text="Freitag, 12. Juni 2026 – 19:00 Uhr"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#0F172A"/>

                    <Label Text="Ort: Annastraße 5, 12345 Musterstadt"
                           FontSize="14"
                           TextColor="#334155"/>

                    <Label Text="Spiel: Catan"
                           FontSize="14"
                           TextColor="#334155"/>

                    <Label Text="Ausrichter: Anna"
                           FontSize="14"
                           TextColor="#1E3A8A"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <Button
                Text="Spielportal"
                Clicked="OnGamesClicked"/>

            <Button
                Text="Terminübersicht"
                Clicked="OnEventClicked"/>

            <Button
                Text="Letzten Spieleabend bewerten"
                Clicked="OnRatingClicked"/>

            <Button
                Text="Nachricht an Gruppe senden"
                Clicked="OnMessageClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>