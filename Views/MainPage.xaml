<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BoardGamerApp.Views"
             x:Class="BoardGamerApp.Views.MainPage"
             BackgroundColor="#F8F5F0">

       <Grid RowDefinitions="Auto,*,80">

              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Padding="30,30,30,0"
                                          Spacing="25">

                            <!-- Vorschau des nächsten Termins auf der Startseite. MainPage bekommt
                                 (genau wie EventPage) ein EventViewModel per Dependency Injection -
                                 da es als "Transient" registriert ist (siehe MauiProgram.cs), ist
                                 das aber ein EIGENES Objekt, nicht dieselbe Instanz wie auf
                                 EventPage. Beide laden also unabhängig voneinander aus derselben
                                 Datenbank. Gezeigt wird hier bewusst NUR der eine chronologisch
                                 nächste Termin (NextUpcomingGameNight), keine Liste mehr. -->
                            <Label Text="Nächster Termin"
                                   Style="{StaticResource Headline}"
                                   FontSize="18"
                                   SemanticProperties.HeadingLevel="Level1"/>

                            <!-- Die Karte bindet ihren eigenen BindingContext auf
                                 NextUpcomingGameNight (ein einzelnes GameNight-Objekt statt einer
                                 Liste) - dadurch beziehen sich alle Bindings darunter (GroupName,
                                 ScheduledAt, ...) direkt auf diesen einen Termin. Sichtbar nur,
                                 wenn es überhaupt einen zukünftigen Termin gibt. -->
                            <Border StrokeShape="RoundRectangle 12"
                                    Padding="15"
                                    Margin="0,0,0,15"
                                    BackgroundColor="#FFF3D6"
                                    Stroke="#8B5E3C"
                                    StrokeThickness="2"
                                    IsVisible="{Binding HasUpcomingEvents}"
                                    BindingContext="{Binding NextUpcomingGameNight}">

                                   <!-- Tippen auf den Termin springt zur EventPage (Terminverwaltung) -
                                        dort kann der Termin dann bearbeitet werden (siehe
                                        EventPage.xaml.cs, OnEditEventClicked). -->
                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnEventPreviewClicked"/>
                                   </Border.GestureRecognizers>

                                   <VerticalStackLayout Spacing="6">

                                          <Label Text="★ Nächster Termin"
                                                 FontSize="12"
                                                 FontAttributes="Bold"
                                                 TextColor="#8B5E3C"/>

                                          <!-- Gruppenname (z. B. "Mittwochsrunde"), aufgelöst über
                                               GroupId -> gaming_groups (siehe EventViewModel.ApplyDisplayNames). -->
                                          <Label Text="{Binding GroupName, StringFormat='{0}'}"
                                                 FontSize="12"
                                                 FontAttributes="Bold"
                                                 TextColor="#8B5E3C"
                                                 IsVisible="{Binding GroupName, Converter={StaticResource StringToBoolConverter}}"/>

                                          <Label Text="{Binding ScheduledAt, Converter={StaticResource IsoToDisplayDateConverter}}"
                                                 FontAttributes="Bold"
                                                 FontSize="16"
                                                 TextColor="#0F172A"/>

                                          <!-- Veranstalter und Ort in einer Zeile: seit Gastgeber und Ort beim
                                               Anlegen gekoppelt sind (Ort = eigener Ort des Gastgebers, siehe
                                               EventViewModel.AddGameNightAsync), wäre eine separate
                                               "Ausrichter: ..."-Zeile redundant zur "Ort: ..."-Zeile. -->
                                          <Label Text="{Binding LocationName, StringFormat='Veranstalter/Ort: {0}'}"
                                                 FontSize="14"
                                                 TextColor="#1E3A8A"
                                                 FontAttributes="Bold"
                                                 IsVisible="{Binding LocationName, Converter={StaticResource StringToBoolConverter}}"/>

                                          <Label Text="{Binding GameName, StringFormat='Spiel: {0}'}"
                                                 FontSize="14"
                                                 TextColor="#334155"
                                                 IsVisible="{Binding GameName, Converter={StaticResource StringToBoolConverter}}"/>

                                          <!-- Prozentanzeige der Zusagen (ohne Gastgeber), siehe
                                               EventViewModel.ApplyAttendanceInfoAsync. -->
                                          <Label Text="{Binding AttendanceSummaryText}"
                                                 FontSize="13"
                                                 TextColor="#0F172A"
                                                 IsVisible="{Binding AttendanceSummaryText, Converter={StaticResource StringToBoolConverter}}"/>

                                          <!-- Zusagen/Absagen: nur sichtbar, wenn der aktuelle Spieler
                                               überhaupt antworten darf (nicht Gastgeber, Termin noch
                                               "planned") - siehe GameNight.CanRespondToAttendance. -->
                                          <HorizontalStackLayout Spacing="10"
                                                                  IsVisible="{Binding CanRespondToAttendance}">
                                                 <Button Text="Zusagen"
                                                         Clicked="OnAcceptClicked"
                                                         BackgroundColor="#2E7D32"
                                                         TextColor="White"
                                                         CornerRadius="8"
                                                         Padding="14,6"
                                                         FontSize="13"/>

                                                 <Button Text="Absagen"
                                                         Clicked="OnDeclineClicked"
                                                         BackgroundColor="#C62828"
                                                         TextColor="White"
                                                         CornerRadius="8"
                                                         Padding="14,6"
                                                         FontSize="13"/>
                                          </HorizontalStackLayout>

                                          <!-- Zeigt die eigene, bereits abgegebene Antwort an (falls
                                               vorhanden) - unabhängig davon, ob die Buttons oben noch
                                               sichtbar sind (der Gastgeber sieht hier nichts, weil
                                               MyAttendanceStatusText für ihn immer null bleibt). -->
                                          <Label Text="{Binding MyAttendanceStatusText}"
                                                 FontSize="13"
                                                 FontAttributes="Italic"
                                                 TextColor="#334155"
                                                 IsVisible="{Binding MyAttendanceStatusText, Converter={StaticResource StringToBoolConverter}}"/>
                                   </VerticalStackLayout>

                            </Border>


                     </VerticalStackLayout>
              </ScrollView>


              <!-- Footer Navigation -->
              <Grid Grid.Row="2"
                    BackgroundColor="#F8F5F0"
                    Padding="20,10"
                    ColumnDefinitions="*,Auto,*"
                    VerticalOptions="End">

                     <!-- Termine -->
                     <VerticalStackLayout Grid.Column="0"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">

                            <VerticalStackLayout.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnEventClicked"/>
                            </VerticalStackLayout.GestureRecognizers>

                            <Image Source="calender_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"/>

                            <Label Text="Termine"
                                   FontSize="12"
                                   TextColor="#8B5E3C"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <!-- Plus Button -->
                     <Frame Grid.Column="1"
                            WidthRequest="60"
                            HeightRequest="60"
                            CornerRadius="30"
                            BackgroundColor="#8B5E3C"
                            HasShadow="True"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">

                            <Frame.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnMessageClicked"/>
                            </Frame.GestureRecognizers>

                            <Image Source="envelope_icon.png"
                                   HeightRequest="28"
                                   WidthRequest="28"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                     </Frame>

            <!-- Gruppe -->
            <VerticalStackLayout Grid.Column="2"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
            <!-- OnClick Methode für Gruppenansicht -->
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGroupClicked"/>
                </VerticalStackLayout.GestureRecognizers>

                            <Image Source="group_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"/>

                            <Label Text="Gruppe"
                                   FontSize="12"
                                   TextColor="#8B5E3C"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>
              </Grid>

       </Grid>
</ContentPage>
