<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BoardGamerApp.Views"
             x:Class="BoardGamerApp.Views.MainPage"
             x:Name="EventPageRoot"
             BackgroundColor="#F8F5F0">

       <Grid RowDefinitions="Auto,*,80">

              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Padding="30,30,30,0"
                                          Spacing="25">

                            <!-- Vorschau des nächsten Termins auf der Startseite. MainPage bekommt
                                 (genau wie EventPage) ein EventViewModel per Dependency Injection -
                                 da es als "Transient" registriert ist (siehe MauiProgram.cs), ist
                                 das aber ein EIGENES Objekt, nicht dieselbe Instanz wie auf
                                 EventPage. Beide laden also unabhängig voneinander aus derselben
                                 Datenbank. Gezeigt wird hier bewusst NUR der eine chronologisch
                                 nächste Termin (NextUpcomingGameNight), keine Liste mehr. -->
                            <Label Text="Nächster Termin"
                                   Style="{StaticResource Headline}"
                                   FontSize="18"
                                   SemanticProperties.HeadingLevel="Level1"/>

                            <!-- Die Karte bindet ihren eigenen BindingContext auf
                                 NextUpcomingGameNight (ein einzelnes GameNight-Objekt statt einer
                                 Liste) - dadurch beziehen sich alle Bindings darunter (GroupName,
                                 ScheduledAt, ...) direkt auf diesen einen Termin. Sichtbar nur,
                                 wenn es überhaupt einen zukünftigen Termin gibt. -->
                            <Border StrokeShape="RoundRectangle 12"
                                    Padding="15"
                                    Margin="0,0,0,15"
                                    BackgroundColor="#FFF3D6"
                                    Stroke="#8B5E3C"
                                    StrokeThickness="2"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.HasUpcomingEvents}"
                                    BindingContext="{Binding NextUpcomingGameNight}">

                                   <!-- Tippen auf den Termin springt zur EventPage (Terminverwaltung) -
                                        dort kann der Termin dann bearbeitet werden (siehe
                                        EventPage.xaml.cs, OnEditEventClicked). -->
                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnEventPreviewClicked"/>
                                   </Border.GestureRecognizers>

                                   <VerticalStackLayout Spacing="6">

                                          <Label Text="★ Nächster Termin"
                                                 FontSize="12"
                                                 FontAttributes="Bold"
                                                 TextColor="#8B5E3C"/>

                                          <!-- Gruppenname (z. B. "Mittwochsrunde"), aufgelöst über
                                               GroupId -> gaming_groups (siehe EventViewModel.ApplyDisplayNames). -->
                                          <Label Text="{Binding GroupName, StringFormat='{0}'}"
                                                 FontSize="12"
                                                 FontAttributes="Bold"
                                                 TextColor="#8B5E3C"
                                                 IsVisible="{Binding GroupName, Converter={StaticResource StringToBoolConverter}}"/>

                                          <Label Text="{Binding ScheduledAt, Converter={StaticResource IsoToDisplayDateConverter}}"
                                                 FontAttributes="Bold"
                                                 FontSize="16"
                                                 TextColor="#0F172A"/>

                                          <!-- Gastgeber und Ort in einer Zeile: seit Gastgeber und Ort beim
                                               Anlegen gekoppelt sind (Ort = eigener Ort des Gastgebers, siehe
                                               EventViewModel.AddGameNightAsync), wäre eine separate
                                               "Gastgeber: ..."-Zeile redundant zur "Ort: ..."-Zeile. -->
                                          <Label Text="{Binding LocationName, StringFormat='Gastgeber/Ort: {0}'}"
                                                 FontSize="14"
                                                 TextColor="#1E3A8A"
                                                 FontAttributes="Bold"
                                                 IsVisible="{Binding LocationName, Converter={StaticResource StringToBoolConverter}}"/>

                                          <Label Text="{Binding GameName, StringFormat='Spiel: {0}'}"
                                                 FontSize="14"
                                                 TextColor="#334155"
                                                 IsVisible="{Binding GameName, Converter={StaticResource StringToBoolConverter}}"/>

                                          <!-- Meistgewähltes Spiel laut Abstimmung der Gruppe (Kollegen-
                                               Feature Spielvorschläge/Abstimmen), siehe
                                               EventViewModel.ApplyTopVotedGame. -->
                                          <Border BackgroundColor="#FFF3D8"
                                                  Stroke="#B87945"
                                                  StrokeThickness="1"
                                                  Padding="8,5"
                                                  Margin="0,4,0,0"
                                                  StrokeShape="RoundRectangle 10"
                                                  IsVisible="{Binding HasTopVotedGame}">

                                                 <Label Text="{Binding TopVotedGameDisplayText}"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        TextColor="#8B5E3C" />
                                          </Border>

                                          <!-- Prozentanzeige der Zusagen (ohne Gastgeber), siehe
                                               EventViewModel.ApplyAttendanceInfoAsync. -->
                                          <Label Text="{Binding AttendanceSummaryText}"
                                                 FontSize="13"
                                                 TextColor="#0F172A"
                                                 IsVisible="{Binding AttendanceSummaryText, Converter={StaticResource StringToBoolConverter}}"/>

                                          <!-- Keine Zusagen/Absagen-Buttons mehr auf dieser Karte: hier
                                               stehen nur noch Termine, an denen der Nutzer ohnehin schon
                                               teilnimmt (Gastgeber oder bereits zugesagt, siehe
                                               EventViewModel.NextUpcomingGameNight) - eine Antwort ist
                                               für die selten Fälle mit noch offener Zusage die
                                               "Noch offen"-Karte darunter zuständig. Der Text hier zeigt
                                               nur noch informativ die eigene, bereits abgegebene
                                               Zusage an (der Gastgeber sieht hier nichts, weil
                                               MyAttendanceStatusText für ihn immer null bleibt). -->
                                          <Label Text="{Binding MyAttendanceStatusText}"
                                                 FontSize="13"
                                                 FontAttributes="Italic"
                                                 TextColor="#334155"
                                                 IsVisible="{Binding MyAttendanceStatusText, Converter={StaticResource StringToBoolConverter}}"/>
                        <!-- Button z. B. auf der Spieleabend-Detailseite oder auf der Home-Seite einfügen. -->
                                            <Button Text="Ich verspäte mich"
                                            Command="{Binding BindingContext.SendDelayMessageCommand, Source={x:Reference EventPageRoot}}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#5B2BEA"
                                            TextColor="White"
                                            CornerRadius="14"
                                            HeightRequest="42" />

                    </VerticalStackLayout>

                            </Border>

                            <!-- Zweite Vorschau-Karte: der nächste Termin, zu dem der Nutzer als
                                 (potentieller) Teilnehmer noch GAR NICHT geantwortet hat (siehe
                                 EventViewModel.NextUnansweredGameNight). Erinnert gezielt an eine
                                 offene Antwort, auch wenn diese nicht zum allerersten Termin oben
                                 gehört. Die Karte ist bewusst genauso aufgebaut wie die
                                 Terminkarten auf EventPage.xaml, damit der Nutzer hier gleich
                                 zusagen/absagen und auch Spiele vorschlagen kann, ohne extra zur
                                 Terminverwaltung wechseln zu müssen. -->
                            <Label Text="Noch offen: Deine Antwort"
                                   Style="{StaticResource Headline}"
                                   FontSize="18"
                                   IsVisible="{Binding HasUnansweredEvent}"
                                   SemanticProperties.HeadingLevel="Level1"/>

                            <Border StrokeShape="RoundRectangle 12"
                                    Padding="15"
                                    Margin="0,0,0,15"
                                    BackgroundColor="White"
                                    Stroke="#8B5E3C"
                                    StrokeThickness="2"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.HasUnansweredEvent}"
                                    BindingContext="{Binding NextUnansweredGameNight}">

                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnEventPreviewClicked"/>
                                   </Border.GestureRecognizers>

                                   <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">

                                          <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="6">

                                                 <Label Text="{Binding GroupName, StringFormat='{0}'}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="#8B5E3C"
                                                        IsVisible="{Binding GroupName, Converter={StaticResource StringToBoolConverter}}"/>

                                                 <Label Text="{Binding ScheduledAt, Converter={StaticResource IsoToDisplayDateConverter}}"
                                                        FontAttributes="Bold"
                                                        FontSize="16"
                                                        TextColor="#0F172A"/>

                                                 <Label Text="{Binding LocationName, StringFormat='Gastgeber/Ort: {0}'}"
                                                        FontSize="14"
                                                        TextColor="#1E3A8A"
                                                        FontAttributes="Bold"
                                                        IsVisible="{Binding LocationName, Converter={StaticResource StringToBoolConverter}}"/>

                                                 <Label Text="{Binding GameName, StringFormat='Spiel: {0}'}"
                                                        FontSize="14"
                                                        TextColor="#334155"
                                                        IsVisible="{Binding GameName, Converter={StaticResource StringToBoolConverter}}"/>

                                                 <Border BackgroundColor="#FFF3D8"
                                                         Stroke="#B87945"
                                                         StrokeThickness="1"
                                                         Padding="8,5"
                                                         Margin="0,4,0,0"
                                                         StrokeShape="RoundRectangle 10"
                                                         IsVisible="{Binding HasTopVotedGame}">

                                                        <Label Text="{Binding TopVotedGameDisplayText}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="#8B5E3C" />
                                                 </Border>

                                                 <Label Text="{Binding Notes, StringFormat='Notiz: {0}'}"
                                                        FontSize="14"
                                                        TextColor="#334155"
                                                        IsVisible="{Binding Notes, Converter={StaticResource StringToBoolConverter}}"/>

                                                 <Label Text="{Binding AttendanceSummaryText}"
                                                        FontSize="13"
                                                        TextColor="#0F172A"
                                                        IsVisible="{Binding AttendanceSummaryText, Converter={StaticResource StringToBoolConverter}}"/>

                                                 <Label Text="{Binding MyAttendanceStatusText}"
                                                        FontSize="13"
                                                        FontAttributes="Italic"
                                                        TextColor="#334155"
                                                        IsVisible="{Binding MyAttendanceStatusText, Converter={StaticResource StringToBoolConverter}}"/>

                                          </VerticalStackLayout>

                                          <!-- Kein Gastgeber-Badge und kein "Termin absagen"-Button auf dieser
                                               Karte: EventViewModel.NextUnansweredGameNight schließt Termine, bei
                                               denen der Nutzer selbst Gastgeber ist, jetzt explizit aus - hier
                                               stehen ausschließlich Termine, bei denen der Nutzer als Gast
                                               zusagen/absagen kann. -->
                                          <HorizontalStackLayout Grid.Column="0"
                                                                  Grid.Row="1"
                                                                  Spacing="10"
                                                                  VerticalOptions="Center"
                                                                  IsVisible="{Binding CanRespondToAttendance}">
                                                 <Button Text="Bin dabei"
                                                         Clicked="OnAcceptClicked"
                                                         BackgroundColor="#2E7D32"
                                                         TextColor="White"
                                                         CornerRadius="8"
                                                         Padding="14,6"
                                                         FontSize="13"/>

                                                 <Button Text="Leider nicht"
                                                         Clicked="OnDeclineClicked"
                                                         BackgroundColor="#C62828"
                                                         TextColor="White"
                                                         CornerRadius="8"
                                                         Padding="14,6"
                                                         FontSize="13"/>
                                          </HorizontalStackLayout>

                                          <!-- "Vorschläge"-Button (Spielvorschläge/Abstimmen) - so kann der
                                               Nutzer direkt von hier aus mitwählen, ohne extra zur
                                               Terminverwaltung zu wechseln. -->
                                          <Button Grid.Column="1"
                                                  Grid.Row="1"
                                                  Text="Vorschläge"
                                                  FontSize="12"
                                                  FontAttributes="Bold"
                                                  Padding="10,4"
                                                  HeightRequest="34"
                                                  BackgroundColor="#8B5E3C"
                                                  TextColor="White"
                                                  CornerRadius="12"
                                                  VerticalOptions="Center"
                                                  HorizontalOptions="End"
                                                  IsVisible="{Binding CanOpenSuggestions}"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.OpenSuggestionsCommand}"
                                                  CommandParameter="{Binding}" />

                                   </Grid>
                            </Border>

                     </VerticalStackLayout>
              </ScrollView>


              <!-- Footer Navigation -->
              <Grid Grid.Row="2"
                    BackgroundColor="#F8F5F0"
                    Padding="20,10"
                    ColumnDefinitions="*,Auto,*"
                    VerticalOptions="End">

                     <!-- Termine -->
                     <VerticalStackLayout Grid.Column="0"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">

                            <VerticalStackLayout.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnEventClicked"/>
                            </VerticalStackLayout.GestureRecognizers>

                            <Image Source="calender_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"/>

                            <Label Text="Termine"
                                   FontSize="12"
                                   TextColor="#8B5E3C"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>

                     <!-- Plus Button -->
                     <Frame Grid.Column="1"
                            WidthRequest="60"
                            HeightRequest="60"
                            CornerRadius="30"
                            BackgroundColor="#8B5E3C"
                            HasShadow="True"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">

                            <Frame.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnMessageClicked"/>
                            </Frame.GestureRecognizers>

                            <Image Source="envelope_icon.png"
                                   HeightRequest="28"
                                   WidthRequest="28"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                     </Frame>

            <!-- Gruppe -->
            <VerticalStackLayout Grid.Column="2"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
            <!-- OnClick Methode für Gruppenansicht -->
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGroupClicked"/>
                </VerticalStackLayout.GestureRecognizers>

                            <Image Source="group_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"/>

                            <Label Text="Gruppe"
                                   FontSize="12"
                                   TextColor="#8B5E3C"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>
              </Grid>

       </Grid>
</ContentPage>
