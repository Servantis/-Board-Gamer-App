<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:BoardGamerApp.ViewModels"
             xmlns:models="clr-namespace:BoardGamerApp.Models"
             x:Class="BoardGamerApp.Views.GroupOverviewPage"
             x:DataType="viewModels:GroupOverviewViewModel"
             Title=""
             BackgroundColor="#F8F5F0">
    <Grid RowDefinitions="Auto,Auto,*"
      Padding="30,20"
      RowSpacing="16">

        <!-- Kopfbereich -->
        <VerticalStackLayout Grid.Row="0"
                         Spacing="6">

            <Label Text="Meine Gruppen"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#3B2E25" />

            <Label Text="Alle zugeordneten Gruppen des ausgewählten Users"
               FontSize="14"
               TextColor="#7C6A58" />

        </VerticalStackLayout>

        <!-- Lade- und Fehlerbereich -->
        <VerticalStackLayout Grid.Row="1"
                         Spacing="8">

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               FontSize="13"
               TextColor="DarkRed" />

        </VerticalStackLayout>

        <!-- Gruppenliste -->
        <RefreshView Grid.Row="2"
                 IsRefreshing="{Binding IsBusy}"
                 Command="{Binding LoadGroupsByPlayerIdAsync}">

            <CollectionView x:Name="GroupCollectionView"
                        ItemsSource="{Binding AssignedGroups}"
                        EmptyView="Noch keine Gruppen vorhanden.">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:GamingGroup">

                        <Border StrokeThickness="0"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 12"
                            Padding="15"
                            Margin="0,0,0,12">

                            <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="6">

                                <!-- Titel -->
                                <Label Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding Name}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#0F172A" />

                                <!-- Löschen-Button -->
                                <ImageButton Grid.Row="0"
                                    Grid.Column="1"
                                    Source="delete_icon.png"
                                    HeightRequest="24"
                                    WidthRequest="24"
                                    Padding="5"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Start"
                                    HorizontalOptions="End"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteOrLeaveGroupCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding CanDelete}"/>

                                <!-- Verlassen-Button -->
                                <ImageButton Grid.Row="0"
                                    Grid.Column="1"
                                    Source="leave_icon.png"
                                    HeightRequest="24"
                                    WidthRequest="24"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Start"
                                    HorizontalOptions="End"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteOrLeaveGroupCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding CanLeave}"/> 

                                <Label Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="{Binding Description}"
                            FontSize="14"
                            TextColor="#334155" />

                                <Label Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="{Binding CreatedByPlayerId}"
                            FontSize="14"
                            TextColor="#334155" />
                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

        <!--Add-Button-->
        <Border
           Grid.Row="2"
           WidthRequest="60"
           HeightRequest="60"
           StrokeShape="RoundRectangle 12"
           BackgroundColor="#8B5E3C"
       
           VerticalOptions="End"
           HorizontalOptions="Center"
           InputTransparent="False">

            <Border.GestureRecognizers>
 <!--               <TapGestureRecognizer Command="{Binding AddGameCommand}" /> -->
            </Border.GestureRecognizers>

            <Image Source="plus_icon.png"
               HeightRequest="28"
               WidthRequest="28"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               InputTransparent="True" />
        </Border>
    </Grid>
</ContentPage>