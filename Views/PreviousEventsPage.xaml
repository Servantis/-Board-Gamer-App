<?xml version="1.0" encoding="utf-8" ?>
<!--
    Liste der vergangenen Termine. BindingContext ist ein PreviousEventsViewModel
    (gesetzt in PreviousEventsPage.xaml.cs, sobald die Termine per Navigation
    ankommen) - die Bindings hier ({Binding PreviousEvents} usw.) beziehen sich
    also auf diese Klasse, nicht direkt auf EventViewModel.
-->
<ContentPage
    x:Class="BoardGamerApp.Views.PreviousEventsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BoardGamerApp.Views"
    BackgroundColor="#F8F5F0">

    <Grid RowDefinitions="Auto,*,80">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="#EDE6DD"
              Padding="20,40,20,20">
            <Label Text="VERGANGENE TERMINE"
                   TextColor="#3B2E25"
                   FontAttributes="Bold"
                   FontSize="20"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Terminliste -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20">

                <CollectionView ItemsSource="{Binding PreviousEvents}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border StrokeThickness="0"
                                    BackgroundColor="#FFFFFF"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12"
                                    Margin="0,6,0,0">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRatingClicked"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      VerticalOptions="Center">

                                    <!-- Datumskreis -->
                                    <Frame Grid.Column="0"
                                           WidthRequest="50"
                                           HeightRequest="50"
                                           CornerRadius="25"
                                           BackgroundColor="#EDE6DD"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center"
                                           HasShadow="False">

                                        <Image Source="exmark_icon.png"
                                               WidthRequest="28"
                                               HeightRequest="28"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"/>
                                    </Frame>

                                    <!-- Termintext -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Padding="10,0"
                                                         VerticalOptions="Center">

                                        <!-- Datum -->
                                        <Label Text="{Binding ScheduledAt, Converter={StaticResource IsoToDisplayDateConverter}}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               TextColor="#3B2E25"/>

                                        <!-- Ort -->
                                        <Label Text="{Binding LocationName, StringFormat='{0}'}"
                                               FontSize="14"
                                               TextColor="#7C6A58"
                                               IsVisible="{Binding LocationName, Converter={StaticResource StringToBoolConverter}}"/>

                                        <!-- Optional: Spielname -->
                                        <Label Text="{Binding GameName, StringFormat='{0}'}"
                                               FontSize="14"
                                               TextColor="#7C6A58"
                                               IsVisible="{Binding GameName, Converter={StaticResource StringToBoolConverter}}"/>

                                    </VerticalStackLayout>

                                    <!-- Bewertet-Badge -->
                                    <Frame Grid.Column="2"
                                           Padding="10,4"
                                           CornerRadius="12"
                                           BackgroundColor="#EDE6DD"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End"
                                           HasShadow="False">
                                        <Label Text="Bewerten"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#7C6A58"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
