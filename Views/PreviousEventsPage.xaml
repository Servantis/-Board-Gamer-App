<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BoardGamerApp.Views.PreviousEventsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F8F5F0">

    <Grid RowDefinitions="Auto,*,80">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="#EDE6DD"
              Padding="20,40,20,20">
            <Label Text="VERGANGENE TERMINE"
                   TextColor="#3B2E25"
                   FontAttributes="Bold"
                   FontSize="20"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Terminliste -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20"
                                 Spacing="15">

                <!-- Termin 1 -->
                <Border StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 12"
                        Padding="12"
                        Margin="0,6,0,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRatingClicked"/>
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          VerticalOptions="Center">

                        <!-- Datumskreis -->
                        <Frame Grid.Column="0"
                               WidthRequest="50"
                               HeightRequest="50"
                               CornerRadius="25"
                               BackgroundColor="#EDE6DD"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HasShadow="False">
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="0">
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Termintext -->
                        <VerticalStackLayout Grid.Column="1"
                                             Padding="10,0"
                                             VerticalOptions="Center">
                            <Label Text="Sonntag, 10. Mai 2026"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#3B2E25"/>
                            <Label Text="Bernd · Beethovenstr. 4"
                                   FontSize="14"
                                   TextColor="#7C6A58"/>
                        </VerticalStackLayout>

                        <!-- Bewertet-Badge -->
                        <Frame Grid.Column="2"
                               Padding="10,4"
                               CornerRadius="12"
                               BackgroundColor="#EDE6DD"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
                               HasShadow="False">
                            <Label Text="Bewerten"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#7C6A58"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                    </Grid>
                </Border>

                <!-- Termin 2 -->
                <Border StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 12"
                        Padding="12"
                        Margin="0,6,0,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRatingClicked"/>
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          VerticalOptions="Center">

                        <!-- Datumskreis -->
                        <Frame Grid.Column="0"
                               WidthRequest="50"
                               HeightRequest="50"
                               CornerRadius="25"
                               BackgroundColor="#EDE6DD"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HasShadow="False">
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="0">
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Termintext -->
                        <VerticalStackLayout Grid.Column="1"
                                             Padding="10,0"
                                             VerticalOptions="Center">
                            <Label Text="Sonntag, 3. Mai 2026"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#3B2E25"/>
                            <Label Text="Markus · Markusstr. 4"
                                   FontSize="14"
                                   TextColor="#7C6A58"/>
                        </VerticalStackLayout>

                        <!-- Bewertet-Badge -->
                        <Frame Grid.Column="2"
                               Padding="10,4"
                               CornerRadius="12"
                               BackgroundColor="#EDE6DD"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
                               HasShadow="False">
                            <Label Text="Bewerten"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#7C6A58"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                    </Grid>
                </Border>

                <!-- Termin 3 -->

                <Border StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 12"
                        Padding="12"
                        Margin="0,6,0,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRatingClicked"/>
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          VerticalOptions="Center">

                        <!-- Datumskreis -->
                        <Frame Grid.Column="0"
                               WidthRequest="50"
                               HeightRequest="50"
                               CornerRadius="25"
                               BackgroundColor="#EDE6DD"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HasShadow="False">
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="0">
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Termintext -->
                        <VerticalStackLayout Grid.Column="1"
                                             Padding="10,0"
                                             VerticalOptions="Center">
                            <Label Text="Sonntag, 5. April 2026"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#3B2E25"/>
                            <Label Text="Anna · Annastr. 4"
                                   FontSize="14"
                                   TextColor="#7C6A58"/>
                        </VerticalStackLayout>

                        <!-- Bewertet-Badge -->
                        <Frame Grid.Column="2"
                               Padding="10,4"
                               CornerRadius="12"
                               BackgroundColor="#EDE6DD"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
                               HasShadow="False">
                            <Label Text="Bewerten"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#7C6A58"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>