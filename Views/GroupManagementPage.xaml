<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:BoardGamerApp.ViewModels"
             xmlns:models="clr-namespace:BoardGamerApp.Models"
             x:Class="BoardGamerApp.Views.GroupManagementPage"
             x:DataType="viewModels:GroupMembersViewModel"
             Title=""
             BackgroundColor="#F8F5F0">
    <Grid RowDefinitions="Auto,*,80">

        <!-- Hauptinhalt -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="30,0"
                              Spacing="25">

                <Grid ColumnDefinitions="Auto,Auto,*"
                  Margin="0,15,0,0"
                  ColumnSpacing="8">

                    <!-- Titel -->
                    <Label Grid.Column="0"
                       Text="Mitgliederverwaltung"
                       Style="{StaticResource SubHeadline}"
                       FontSize="18"
                       VerticalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1"/>
                </Grid>

                <Border StrokeThickness="0"
                     BackgroundColor="#FFFFFF"
                     StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout Padding="15"
                                      Spacing="6">
                        <Label Text="Mitglieder"
                            FontAttributes="Bold"
                            FontSize="16"
                            TextColor="#0F172A"/>

                        <!-- Ansicht generiert-->
                        <CollectionView
                             MaximumHeightRequest="300"
                             ItemsSource="{Binding Members}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupMemberListItem">

                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                   Padding="10"
                                   VerticalOptions="Center">

                                        <!-- Avatar / Initialen-Kreis -->
                                        <Border Grid.Column="0"
                                         WidthRequest="50"
                                         HeightRequest="50"
                                         StrokeThickness="0"
                                         BackgroundColor="#EDE6DD"
                                         StrokeShape="RoundRectangle 25"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center">

                                            <Label Text="{Binding Initials}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="#7C6A58"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"/>
                                        </Border>

                                        <!-- Textbereich -->
                                        <VerticalStackLayout Grid.Column="1"
                                          Padding="10,0"
                                          VerticalOptions="Center">

                                            <Label Text="{Binding DisplayName}"
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            TextColor="#3B2E25"/>

                                            <Label Text="{Binding Email}"
                                            FontSize="14"
                                            TextColor="#7C6A58"/>
                                        </VerticalStackLayout>
                                            <ImageButton
                                                Grid.Column="2"
                                                Source="delete_icon.png"
                                                BackgroundColor="Transparent"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                Padding="8"
                                                IsVisible="{Binding CanRemove}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                    Path=BindingContext.RemoveMemberCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                
            </VerticalStackLayout>
        </ScrollView>


        <!--Add-Button-->
        <Border
           Grid.Row="2"
           WidthRequest="60"
           HeightRequest="60"
           StrokeShape="RoundRectangle 12"
           BackgroundColor="#8B5E3C"
       
           VerticalOptions="End"
           HorizontalOptions="Center"
           InputTransparent="False">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenAddPlayerPageCommand}" />
            </Border.GestureRecognizers>

            <Image Source="plus_icon.png"
               HeightRequest="28"
               WidthRequest="28"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               InputTransparent="True" />
        </Border>
    </Grid>
</ContentPage>