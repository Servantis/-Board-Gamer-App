<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
       x:Class="BoardGamerApp.Views.EventPage"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       BackgroundColor="#F5F7FA">

       <VerticalStackLayout Padding="0"
                            Spacing="0">

              <!-- Header -->
              <Grid BackgroundColor="#EDE6DD"
                    Padding="20,40,20,20">
                     <Label Text="KOMMENDE SPIELE"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
              </Grid>

              <!-- Terminliste -->
              <ScrollView>
                     <VerticalStackLayout Padding="20"
                                          Spacing="15">

                            <!-- Termin 1 -->
                            <Frame CornerRadius="12"
                                   Padding="15"
                                   BackgroundColor="White"
                                   HasShadow="True">

                                   <VerticalStackLayout Spacing="6">

                                          <Label Text="Freitag, 12. Juni 2026 – 19:00 Uhr"
                                                 FontAttributes="Bold"
                                                 FontSize="16"
                                                 TextColor="#0F172A"/>

                                          <Label Text="Ort: Annastraße 5, 12345 Musterstadt"
                                                 FontSize="14"
                                                 TextColor="#334155"/>

                                          <Label Text="Spiel: Catan"
                                                 FontSize="14"
                                                 TextColor="#334155"/>

                                          <Label Text="Ausrichter: Anna"
                                                 FontSize="14"
                                                 TextColor="#1E3A8A"
                                                 FontAttributes="Bold"/>
                                   </VerticalStackLayout>
                            </Frame>

                            <!-- Termin 2 -->
                            <Frame CornerRadius="12"
                                   Padding="15"
                                   BackgroundColor="White"
                                   HasShadow="True">

                                   <VerticalStackLayout Spacing="6">

                                          <Label Text="Samstag, 20. Juni 2026 – 18:30 Uhr"
                                                 FontAttributes="Bold"
                                                 FontSize="16"
                                                 TextColor="#0F172A"/>

                                          <Label Text="Ort: Markusstraße 10, 12345 Musterstadt"
                                                 FontSize="14"
                                                 TextColor="#334155"/>

                                          <Label Text="Spiel: Azul"
                                                 FontSize="14"
                                                 TextColor="#334155"/>

                                          <Label Text="Ausrichter: Markus"
                                                 FontSize="14"
                                                 TextColor="#1E3A8A"
                                                 FontAttributes="Bold"/>
                                   </VerticalStackLayout>
                            </Frame>

                            <!-- Termin 3 -->
                            <Frame CornerRadius="12"
                                   Padding="15"
                                   BackgroundColor="White"
                                   HasShadow="True">

                                   <VerticalStackLayout Spacing="6">

                                          <Label Text="Freitag, 3. Juli 2026 – 20:00 Uhr"
                                                 FontAttributes="Bold"
                                                 FontSize="16"
                                                 TextColor="#0F172A"/>

                                          <Label Text="Ort: Peterstraße 15, 12345 Musterstadt"
                                                 FontSize="14"
                                                 TextColor="#334155"/>

                                          <Label Text="Spiel: Carcassonne"
                                                 FontSize="14"
                                                 TextColor="#334155"/>

                                          <Label Text="Ausrichter: Peter"
                                                 FontSize="14"
                                                 TextColor="#1E3A8A"
                                                 FontAttributes="Bold"/>
                                   </VerticalStackLayout>
                            </Frame>
                     </VerticalStackLayout>
              </ScrollView>
       </VerticalStackLayout>
</ContentPage>