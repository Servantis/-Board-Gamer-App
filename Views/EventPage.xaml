<?xml version="1.0" encoding="utf-8" ?>

<!--
    Hauptseite der Terminverwaltung.
    BindingContext ist ein EventViewModel (siehe EventPage.xaml.cs) - alle {Binding ...}
    in dieser Datei beziehen sich also auf Properties/Commands von EventViewModel.
-->
<ContentPage
       x:Class="BoardGamerApp.Views.EventPage"
       xmlns:local="clr-namespace:BoardGamerApp.Views"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       BackgroundColor="#F8F5F0">

       <Grid RowDefinitions="Auto,*,80">

              <!-- Header -->
              <Grid Grid.Row="0"
                    BackgroundColor="#EDE6DD"
                    Padding="20,40,20,20">
                     <Label Text="TERMINVERWALTUNG"
                            TextColor="#3B2E25"
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
              </Grid>

              <!-- Terminliste: zeigt die ZUKÜNFTIGEN Termine, gefiltert über StatusFilter
                   (siehe EventViewModel.FilteredUpcomingGameNights) - "Alle" zeigt auch
                   abgesagte Termine mit an, statt sie komplett zu verstecken. Vergangene
                   Termine sieht man über den Button "Vergangene Termine" unten. -->
              <ScrollView Grid.Row="1">
                     <VerticalStackLayout Padding="20">

                            <!-- Filter-Buttons: der jeweils aktive Filter wird per DataTrigger
                                 auf StatusFilter braun hervorgehoben, alle anderen bleiben beige. -->
                            <HorizontalStackLayout Spacing="10" Margin="0,0,0,15">
                                   <Button Text="Alle"
                                           Command="{Binding SetStatusFilterCommand}"
                                           CommandParameter="all"
                                           BackgroundColor="#EDE6DD"
                                           TextColor="#3B2E25"
                                           CornerRadius="10"
                                           Padding="14,6"
                                           FontSize="13">
                                          <Button.Triggers>
                                                 <DataTrigger TargetType="Button" Binding="{Binding StatusFilter}" Value="all">
                                                        <Setter Property="BackgroundColor" Value="#8B5E3C"/>
                                                        <Setter Property="TextColor" Value="White"/>
                                                 </DataTrigger>
                                          </Button.Triggers>
                                   </Button>

                                   <Button Text="Geplant"
                                           Command="{Binding SetStatusFilterCommand}"
                                           CommandParameter="planned"
                                           BackgroundColor="#EDE6DD"
                                           TextColor="#3B2E25"
                                           CornerRadius="10"
                                           Padding="14,6"
                                           FontSize="13">
                                          <Button.Triggers>
                                                 <DataTrigger TargetType="Button" Binding="{Binding StatusFilter}" Value="planned">
                                                        <Setter Property="BackgroundColor" Value="#8B5E3C"/>
                                                        <Setter Property="TextColor" Value="White"/>
                                                 </DataTrigger>
                                          </Button.Triggers>
                                   </Button>

                                   <Button Text="Abgesagt"
                                           Command="{Binding SetStatusFilterCommand}"
                                           CommandParameter="cancelled"
                                           BackgroundColor="#EDE6DD"
                                           TextColor="#3B2E25"
                                           CornerRadius="10"
                                           Padding="14,6"
                                           FontSize="13">
                                          <Button.Triggers>
                                                 <DataTrigger TargetType="Button" Binding="{Binding StatusFilter}" Value="cancelled">
                                                        <Setter Property="BackgroundColor" Value="#8B5E3C"/>
                                                        <Setter Property="TextColor" Value="White"/>
                                                 </DataTrigger>
                                          </Button.Triggers>
                                   </Button>
                            </HorizontalStackLayout>

                            <CollectionView ItemsSource="{Binding FilteredUpcomingGameNights}">
                                   <CollectionView.ItemTemplate>
                                          <DataTemplate>

                                                 <!-- SwipeView: nach links wischen zeigt den roten "Löschen"-Button.
                                                      Jede Zeile bekommt automatisch ihren eigenen GameNight als
                                                      BindingContext (DataTemplate-Prinzip) - deshalb muss man für
                                                      das Command extra über RelativeSource zum BindingContext der
                                                      GANZEN Seite (also dem EventViewModel) hochgreifen, während
                                                      CommandParameter="{Binding}" einfach "diesen einen Termin" meint. -->
                                                 <SwipeView>
                                                        <SwipeView.RightItems>
                                                               <SwipeItems Mode="Reveal">
                                                                      <SwipeItem
                                                                             Text="Löschen"
                                                                             BackgroundColor="Red"
                                                                             IconImageSource="trash_icon.png"
                                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type local:EventPage}}, Path=BindingContext.DeleteEventCommand}"
                                                                             CommandParameter="{Binding}"/>
                                                               </SwipeItems>
                                                        </SwipeView.RightItems>

                                                        <!-- Die ganze Karte ist antippbar (Tapped="OnEditEventClicked") und
                                                             öffnet den Termin zum Bearbeiten im NewEventPopup (siehe
                                                             EventPage.xaml.cs). Das "Bearbeiten"-Badge rechts ist rein
                                                             visuell (zeigt dem Nutzer, WAS beim Antippen passiert) - genau
                                                             wie das "Bewerten"-Badge auf PreviousEventsPage.xaml. -->
                                                        <Frame CornerRadius="12"
                                                               Padding="15"
                                                               Margin="0,0,0,15"
                                                               BackgroundColor="White"
                                                               HasShadow="False">

                                                               <!-- Abgesagte Termine (siehe GameNight.IsCancelled) bekommen einen
                                                                    leicht rötlichen Hintergrund, damit sie in der "Alle"-Ansicht
                                                                    optisch von geplanten Terminen zu unterscheiden sind. -->
                                                               <Frame.Triggers>
                                                                      <DataTrigger TargetType="Frame" Binding="{Binding IsCancelled}" Value="True">
                                                                             <Setter Property="BackgroundColor" Value="#F5E6E6"/>
                                                                      </DataTrigger>
                                                               </Frame.Triggers>

                                                               <Frame.GestureRecognizers>
                                                                      <TapGestureRecognizer Tapped="OnEditEventClicked"/>
                                                               </Frame.GestureRecognizers>

                                                               <!-- Zwei Grid-Zeilen: Zeile 0 die eigentliche Terminanzeige samt
                                                                    "Bearbeiten"-Badge oben rechts, Zeile 1 nur für Zusagen/Absagen
                                                                    (Spalte 0) und den "Vorschläge"-Button (Spalte 1) - weil beide
                                                                    in DERSELBEN Grid-Zeile liegen, stehen sie immer auf gleicher
                                                                    Höhe nebeneinander, unabhängig davon, wie viele der optionalen
                                                                    Zeilen (Spiel, Notiz, ...) darüber gerade sichtbar sind. -->
                                                               <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">

                                                                      <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="6">

                                                                             <!-- "Abgesagt"-Badge, nur bei Status "cancelled" sichtbar. -->
                                                                             <Label Text="Abgesagt"
                                                                                    FontSize="12"
                                                                                    FontAttributes="Bold"
                                                                                    TextColor="#C62828"
                                                                                    IsVisible="{Binding IsCancelled}"/>

                                                                             <!-- Gruppenname (z. B. "Mittwochsrunde"), aufgelöst über
                                                                                  GroupId -> gaming_groups (siehe EventViewModel.ApplyDisplayNames). -->
                                                                             <Label Text="{Binding GroupName, StringFormat='{0}'}"
                                                                                    FontSize="12"
                                                                                    FontAttributes="Bold"
                                                                                    TextColor="#8B5E3C"
                                                                                    IsVisible="{Binding GroupName, Converter={StaticResource StringToBoolConverter}}"/>

                                                                             <!-- Datum -->
                                                                             <Label Text="{Binding ScheduledAt, Converter={StaticResource IsoToDisplayDateConverter}}"
                                                                                    FontAttributes="Bold"
                                                                                    FontSize="16"
                                                                                    TextColor="#0F172A"/>

                                                                             <!-- Spiel, Notiz und Gastgeber/Ort sind alle optional (siehe GameNight.cs),
                                                                                  deshalb blendet der StringToBoolConverter jede Zeile automatisch aus,
                                                                                  wenn der jeweilige Wert null/leer ist - statt z. B. "Spiel: " leer anzuzeigen. -->

                                                                             <!-- Gastgeber und Ort in einer Zeile: seit Gastgeber und Ort beim
                                                                                  Anlegen gekoppelt sind (Ort = eigener Ort des Gastgebers, siehe
                                                                                  EventViewModel.AddGameNightAsync), wäre eine separate
                                                                                  "Gastgeber: ..."-Zeile redundant zur "Ort: ..."-Zeile. -->
                                                                             <Label Text="{Binding LocationName, StringFormat='Gastgeber/Ort: {0}'}"
                                                                                    FontSize="14"
                                                                                    TextColor="#1E3A8A"
                                                                                    FontAttributes="Bold"
                                                                                    IsVisible="{Binding LocationName, Converter={StaticResource StringToBoolConverter}}"/>

                                                                             <!-- Spiel -->
                                                                             <Label Text="{Binding GameName, StringFormat='Spiel: {0}'}"
                                                                                    FontSize="14"
                                                                                    TextColor="#334155"
                                                                                    IsVisible="{Binding GameName, Converter={StaticResource StringToBoolConverter}}"/>
                                                                            <Border BackgroundColor="#FFF3D8"
                                                                            Stroke="#B87945"
                                                                            StrokeThickness="1"
                                                                            Padding="8,5"
                                                                            Margin="0,4,0,0"
                                                                            StrokeShape="RoundRectangle 10"
                                                                            IsVisible="{Binding HasTopVotedGame}">

                                                                            <Label Text="{Binding TopVotedGameDisplayText}"
                                                                            FontSize="13"
                                                                            FontAttributes="Bold"
                                                                            TextColor="#8B5E3C" />
                                                                            </Border>
                                            <!-- Notiz -->
                                                                             <Label Text="{Binding Notes, StringFormat='Notiz: {0}'}"
                                                                                    FontSize="14"
                                                                                    TextColor="#334155"
                                                                                    IsVisible="{Binding Notes, Converter={StaticResource StringToBoolConverter}}"/>

                                                                             <!-- Prozentanzeige der Zusagen (ohne Gastgeber), siehe
                                                                                  EventViewModel.ApplyAttendanceInfoAsync. Nur bei noch
                                                                                  "planned"-Terminen mit mindestens einem weiteren
                                                                                  Gruppenmitglied gesetzt (sonst null, siehe GameNight.cs). -->
                                                                             <Label Text="{Binding AttendanceSummaryText}"
                                                                                    FontSize="13"
                                                                                    TextColor="#0F172A"
                                                                                    IsVisible="{Binding AttendanceSummaryText, Converter={StaticResource StringToBoolConverter}}"/>

                                                                             <!-- Eigene Zu-/Absage, falls schon beantwortet. -->
                                                                             <Label Text="{Binding MyAttendanceStatusText}"
                                                                                    FontSize="13"
                                                                                    FontAttributes="Italic"
                                                                                    TextColor="#334155"
                                                                                    IsVisible="{Binding MyAttendanceStatusText, Converter={StaticResource StringToBoolConverter}}"/>

                                                                      </VerticalStackLayout>

                                                                      <!-- "Gastgeber"-Badge fest oben rechts in der Terminkarte (VerticalOptions="Start"
                                                                           statt "Center", damit er IMMER an der Karten-Oberkante klebt, egal wie
                                                                           viele der optionalen Zeilen links gerade sichtbar sind, statt in der Mitte
                                                                           der (unterschiedlich hohen) Terminanzeige zu "schweben"). Nur sichtbar,
                                                                           wenn der aktuelle Spieler diesen Termin auch bearbeiten darf (siehe
                                                                           GameNight.CanBeEditedByCurrentPlayer - nur der Gastgeber, nicht bei
                                                                           abgesagten Terminen) - markiert also gleichzeitig "das ist dein Termin"
                                                                           UND "hier tippen zum Bearbeiten". Optisch bewusst in der Marken-Akzentfarbe
                                                                           gehalten (statt dem neutralen Beige wie das "Bewerten"-Badge auf
                                                                           PreviousEventsPage.xaml), damit er als Gastgeber sofort ins Auge fällt.

                                                                           InputTransparent="True" auf Frame UND Label ist hier wichtig:
                                                                           ein Frame mit eigener BackgroundColor "fängt" Touch-Events sonst
                                                                           selbst ab, statt sie an das TapGestureRecognizer des äußeren
                                                                           Frames (weiter oben, "OnEditEventClicked") weiterzugeben. Mit
                                                                           InputTransparent="True" wird dieser Bereich für Touches
                                                                           "durchsichtig" - der Tap landet dann beim äußeren Frame, egal
                                                                           WO auf der Karte man tippt (auch direkt auf das Badge). -->
                                                                      <Frame Grid.Column="1"
                                                                             Grid.Row="0"
                                                                             Padding="10,5"
                                                                             CornerRadius="12"
                                                                             BackgroundColor="#8B5E3C"
                                                                             VerticalOptions="Start"
                                                                             HorizontalOptions="End"
                                                                             HasShadow="True"
                                                                             InputTransparent="True"
                                                                             IsVisible="{Binding CanBeEditedByCurrentPlayer}">
                                                                             <Label Text="Gastgeber"
                                                                                    FontSize="12"
                                                                                    FontAttributes="Bold"
                                                                                    TextColor="White"
                                                                                    HorizontalOptions="Center"
                                                                                    VerticalOptions="Center"
                                                                                    InputTransparent="True"/>
                                                                      </Frame>

                                                                      <!-- Zusagen/Absagen: nur für Nicht-Gastgeber bei noch
                                                                           geplanten Terminen sichtbar (siehe
                                                                           GameNight.CanRespondToAttendance). Der Gastgeber selbst
                                                                           bearbeitet den Termin stattdessen über das
                                                                           "Bearbeiten"-Badge/den Karten-Tap. Steht in derselben
                                                                           Grid-Zeile wie der "Vorschläge"-Button rechts daneben,
                                                                           damit beide auf gleicher Höhe stehen. -->
                                                                      <HorizontalStackLayout Grid.Column="0"
                                                                                             Grid.Row="1"
                                                                                             Spacing="10"
                                                                                             VerticalOptions="Center"
                                                                                             IsVisible="{Binding CanRespondToAttendance}">
                                                                             <Button Text="Bin dabei"
                                                                                     Clicked="OnAcceptClicked"
                                                                                     BackgroundColor="#2E7D32"
                                                                                     TextColor="White"
                                                                                     CornerRadius="8"
                                                                                     Padding="14,6"
                                                                                     FontSize="13"/>

                                                                             <Button Text="Leider nicht"
                                                                                     Clicked="OnDeclineClicked"
                                                                                     BackgroundColor="#C62828"
                                                                                     TextColor="White"
                                                                                     CornerRadius="8"
                                                                                     Padding="14,6"
                                                                                     FontSize="13"/>
                                                                      </HorizontalStackLayout>

                                                                      <!-- "Termin absagen": nur für den Gastgeber selbst sichtbar,
                                                                           solange der Termin noch "planned" ist (siehe
                                                                           GameNight.CanCancelEventByHost). Steht in derselben Grid-Zelle
                                                                           wie die Zusagen/Absagen-Buttons oben, weil die beiden sich
                                                                           gegenseitig ausschließen (man ist entweder Gastgeber oder
                                                                           normales Gruppenmitglied, nie beides gleichzeitig). Command
                                                                           zeigt vorher eine Sicherheitsabfrage, siehe
                                                                           EventViewModel.CancelEventAsync. -->
                                                                      <Button Grid.Column="0"
                                                                              Grid.Row="1"
                                                                              Text="Termin absagen"
                                                                              BackgroundColor="#C62828"
                                                                              TextColor="White"
                                                                              CornerRadius="8"
                                                                              Padding="14,6"
                                                                              FontSize="13"
                                                                              VerticalOptions="Center"
                                                                              HorizontalOptions="Start"
                                                                              IsVisible="{Binding CanCancelEventByHost}"
                                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type local:EventPage}}, Path=BindingContext.CancelEventCommand}"
                                                                              CommandParameter="{Binding}"/>

                                                                      <!-- "Vorschläge"-Button (Kollegen-Feature Spielvorschläge/Abstimmen) -
                                                                           liegt in derselben Grid-Zeile wie die Zusagen/Absagen-Buttons
                                                                           links daneben (Grid.Row="1"), damit beide auf gleicher Höhe
                                                                           stehen, statt wie vorher zentriert über die ganze Kartenhöhe.
                                                                           Bei bereits abgesagten Terminen (siehe GameNight.IsCancelled)
                                                                           ausgeblendet, weil eine Abstimmung über die Spiele dann keinen
                                                                           Sinn mehr ergibt. -->
                                                                      <Button Grid.Column="1"
                                                                              Grid.Row="1"
                                                                              Text="Vorschläge"
                                                                              FontSize="12"
                                                                              FontAttributes="Bold"
                                                                              Padding="10,4"
                                                                              HeightRequest="34"
                                                                              BackgroundColor="#8B5E3C"
                                                                              TextColor="White"
                                                                              CornerRadius="12"
                                                                              VerticalOptions="Center"
                                                                              HorizontalOptions="End"
                                                                              IsVisible="{Binding CanOpenSuggestions}"
                                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type local:EventPage}}, Path=BindingContext.OpenSuggestionsCommand}"
                                                                              CommandParameter="{Binding}" />

                                                                </Grid>

                                                        </Frame>
                                                 </SwipeView>

                                          </DataTemplate>
                                   </CollectionView.ItemTemplate>
                            </CollectionView>

                     </VerticalStackLayout>
              </ScrollView>

              <!-- Footer Navigation -->
              <Grid Grid.Row="2"
                    BackgroundColor="#F8F5F0"
                    Padding="20,10"
                    ColumnDefinitions="*,Auto,*"
                    VerticalOptions="End">

                     <!-- Plus Button -->
                     <Frame Grid.Column="1"
                            WidthRequest="60"
                            HeightRequest="60"
                            CornerRadius="30"
                            BackgroundColor="#8B5E3C"
                            HasShadow="True"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            InputTransparent="False">

                            <Frame.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnNewEventClicked"/>
                            </Frame.GestureRecognizers>

                            <Image Source="plus_icon.png"
                                   HeightRequest="28"
                                   WidthRequest="28"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   InputTransparent="True"/>
                     </Frame>

                     <VerticalStackLayout Grid.Column="2"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">

                            <VerticalStackLayout.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnPreviousEventsClicked"/>
                            </VerticalStackLayout.GestureRecognizers>

                            <Image Source="backintime_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"/>

                            <Label Text="Vergangene Termine"
                                   FontSize="12"
                                   TextColor="#8B5E3C"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>
              </Grid>

       </Grid>
</ContentPage>
