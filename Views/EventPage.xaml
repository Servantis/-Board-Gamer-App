<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
       x:Class="BoardGamerApp.Views.EventPage"
       xmlns:local="clr-namespace:BoardGamerApp.Views"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       BackgroundColor="#F8F5F0">

       <Grid RowDefinitions="Auto,*,80">

              <!-- Header -->
              <Grid Grid.Row="0"
                    BackgroundColor="#EDE6DD"
                    Padding="20,40,20,20">
                     <Label Text="TERMINVERWALTUNG"
                            TextColor="#3B2E25"
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
              </Grid>

              <!-- Terminliste -->
              <ScrollView Grid.Row="1">

                     <!-- Abstand zum Rand -->
                     <VerticalStackLayout Padding="20">

                            <CollectionView ItemsSource="{Binding UpcomingEvents}">
                                   <CollectionView.ItemTemplate>
                                          <DataTemplate>

                                                 <SwipeView>
                                                        <SwipeView.RightItems>
                                                               <SwipeItems Mode="Reveal">
                                                                      <SwipeItem
                                                                             Text="Löschen"
                                                                             BackgroundColor="Red"
                                                                             IconImageSource="trash_icon.png"
                                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type local:EventPage}}, Path=BindingContext.DeleteEventCommand}"
                                                                             CommandParameter="{Binding}"/>
                                                               </SwipeItems>
                                                        </SwipeView.RightItems>

                                                        <Frame CornerRadius="12"
                                                               Padding="15"
                                                               Margin="0,0,0,15"
                                                               BackgroundColor="White"
                                                               HasShadow="False">

                                                               <Frame.GestureRecognizers>
                                                                      <TapGestureRecognizer Tapped="OnGamesClicked"/>
                                                               </Frame.GestureRecognizers>

                                                               <VerticalStackLayout Spacing="6">
                                                                      <Label Text="{Binding DisplayDate}"
                                                                             FontAttributes="Bold"
                                                                             FontSize="16"
                                                                             TextColor="#0F172A"/>

                                                                      <Label Text="{Binding Location, StringFormat='Ort: {0}'}"
                                                                             FontSize="14"
                                                                             TextColor="#334155"/>

                                                                      <Label Text="{Binding Game, StringFormat='Spiel: {0}'}"
                                                                             FontSize="14"
                                                                             TextColor="#334155"/>

                                                                      <Label Text="{Binding Host, StringFormat='Veranstalter: {0}'}"
                                                                             FontSize="14"
                                                                             TextColor="#1E3A8A"
                                                                             FontAttributes="Bold"/>
                                                               </VerticalStackLayout>

                                                        </Frame>
                                                 </SwipeView>


                                          </DataTemplate>
                                   </CollectionView.ItemTemplate>
                            </CollectionView>

                     </VerticalStackLayout>

              </ScrollView>

              <!-- Footer Navigation -->
              <Grid Grid.Row="2"
                    BackgroundColor="#F8F5F0"
                    Padding="20,10"
                    ColumnDefinitions="*,Auto,*"
                    VerticalOptions="End">

                     <!-- Plus Button -->
                     <Frame Grid.Column="1"
                            WidthRequest="60"
                            HeightRequest="60"
                            CornerRadius="30"
                            BackgroundColor="#8B5E3C"
                            HasShadow="True"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            InputTransparent="False">

                            <Frame.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnNewEventClicked"/>
                            </Frame.GestureRecognizers>

                            <Image Source="plus_icon.png"
                                   HeightRequest="28"
                                   WidthRequest="28"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   InputTransparent="True"/>
                     </Frame>

                     <VerticalStackLayout Grid.Column="2"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">

                            <VerticalStackLayout.GestureRecognizers>
                                   <!--Durch dazugehörige OnxxxxClicked-Methode ersetzen-->
                                   <TapGestureRecognizer Tapped="OnPreviousEventsClicked"/>
                            </VerticalStackLayout.GestureRecognizers>

                            <Image Source="backintime_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"/>

                            <Label Text="Vergangene Termine"
                                   FontSize="12"
                                   TextColor="#8B5E3C"
                                   HorizontalOptions="Center"/>
                     </VerticalStackLayout>
              </Grid>
       </Grid>
</ContentPage>