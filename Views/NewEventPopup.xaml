<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
       x:Class="BoardGamerApp.Views.NewEventPopup"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
       Color="Transparent">

       <Border
              StrokeShape="RoundRectangle 20"
              BackgroundColor="#F8F5F0"
              Padding="20"
              HorizontalOptions="Center"
              VerticalOptions="Center">

              <!-- Unsichtbare Picker außerhalb des sichtbaren Layouts -->
              <Grid>
                     <VerticalStackLayout Spacing="15"
                                          HorizontalOptions="Fill"
                                          WidthRequest="300">

                            <Label Text="Neuen Termin anlegen"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#3B2E25"/>

                            <!-- Kombiniertes Datum/Uhrzeit-Feld -->
                            <VerticalStackLayout>
                                   <Border x:Name="DateTimeBorder"
                                           BackgroundColor="#EDE6DD"
                                           Padding="10">
                                          <Border.GestureRecognizers>
                                                 <TapGestureRecognizer Tapped="OnDateTimeTapped"/>
                                          </Border.GestureRecognizers>

                                          <Label x:Name="DateTimeLabel"
                                                 Text="Datum und Uhrzeit wählen"/>
                                   </Border>

                                   <DatePicker x:Name="InlineDatePicker"
                                               IsVisible="False"
                                               Format="dd.MM.yyyy"
                                               DateSelected="OnInlineDateSelected"/>

                                   <TimePicker x:Name="InlineTimePicker"
                                               IsVisible="False"
                                               Format="HH:mm"
                                               TimeSelected="OnInlineTimeChanged"/>
                            </VerticalStackLayout>

                            <Entry x:Name="LocationEntry"
                                   Placeholder="Ort"
                                   BackgroundColor="#EDE6DD"/>

                            <Entry x:Name="GameEntry"
                                   Placeholder="Spiel"
                                   BackgroundColor="#EDE6DD"/>

                            <Entry x:Name="HostEntry"
                                   Placeholder="Veranstalter"
                                   BackgroundColor="#EDE6DD"/>

                            <Button Text="Speichern"
                                    BackgroundColor="#8B5E3C"
                                    TextColor="White"
                                    CornerRadius="12"
                                    Clicked="OnSaveClicked"/>
                     </VerticalStackLayout>

                     <!-- Unsichtbare Picker außerhalb des sichtbaren Layouts -->
                     <DatePicker x:Name="HiddenDatePicker"
                                 Opacity="0.01"
                                 TranslationX="-5000"
                                 TranslationY="0"
                                 WidthRequest="200"
                                 HeightRequest="50"/>

                     <TimePicker x:Name="HiddenTimePicker"
                                 Opacity="0.01"
                                 TranslationX="-5000"
                                 TranslationY="0"
                                 WidthRequest="200"
                                 HeightRequest="50"/>
              </Grid>
       </Border>
</toolkit:Popup>