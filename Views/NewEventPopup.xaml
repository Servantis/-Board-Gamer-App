<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
       x:Class="BoardGamerApp.Views.NewEventPopup"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
       xmlns:sys="clr-namespace:System;assembly=mscorlib"
       Color="#80000000">

       <Border StrokeShape="RoundRectangle 20"
               BackgroundColor="#F8F5F0"
               Padding="20"
               HorizontalOptions="Center"
               VerticalOptions="Center">
              <!-- Unsichtbare Picker außerhalb des sichtbaren Layouts -->
              <Grid>
                     <VerticalStackLayout Spacing="15"
                                          HorizontalOptions="Fill"
                                          WidthRequest="300">

                            <Label Text="Neuen Termin anlegen"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#3B2E25"/>

                            <!-- Kombiniertes Datum/Uhrzeit-Feld -->
                            <Border x:Name="DateTimeBorder"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="#EDE6DD"
                                    HeightRequest="48"
                                    Padding="10">
                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnDateTimeTapped"/>
                                   </Border.GestureRecognizers>

                                   <HorizontalStackLayout>
                                          <Label x:Name="DateTimeLabel"
                                                 Text="Datum und Uhrzeit wählen"
                                                 TextColor="#3B2E25"
                                                 VerticalOptions="Center"/>
                                          <Image Source="calendar.png"
                                                 WidthRequest="20"
                                                 HeightRequest="20"
                                                 Margin="10,0,0,0"
                                                 VerticalOptions="Center"/>
                                   </HorizontalStackLayout>
                            </Border>

                            <Entry x:Name="LocationEntry"
                                   Placeholder="Ort"
                                   BackgroundColor="#EDE6DD"/>

                            <Entry x:Name="GameEntry"
                                   Placeholder="Spiel"
                                   BackgroundColor="#EDE6DD"/>

                            <Entry x:Name="HostEntry"
                                   Placeholder="Veranstalter"
                                   BackgroundColor="#EDE6DD"/>

                            <Button Text="Speichern"
                                    BackgroundColor="#8B5E3C"
                                    TextColor="White"
                                    CornerRadius="12"
                                    Clicked="OnSaveClicked"/>
                     </VerticalStackLayout>

                     <!-- Unsichtbare Picker außerhalb des sichtbaren Layouts -->
                     <DatePicker x:Name="HiddenDatePicker"
                                 IsVisible="False"/>
                     <TimePicker x:Name="HiddenTimePicker"
                                 IsVisible="False"/>
              </Grid>
       </Border>
</toolkit:Popup>