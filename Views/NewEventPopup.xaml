<?xml version="1.0" encoding="utf-8" ?>
<!--
    Dialog zum Anlegen eines neuen Termins.

    Wichtig: LocationPicker/HostPicker und GamesCollectionView haben hier KEIN
    ItemsSource-Binding in XAML - das wird stattdessen im Code-Behind
    (NewEventPopup.xaml.cs, Konstruktor) direkt gesetzt, z. B.:
        LocationPicker.ItemsSource = _viewModel.Locations;
    Das ist hier bewusst so gelöst, weil dieses Popup ohne eigenen BindingContext
    arbeitet (siehe Kommentar in NewEventPopup.xaml.cs).
-->
<toolkit:Popup
       x:Class="BoardGamerApp.Views.NewEventPopup"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
       Color="Transparent">

       <Border
              StrokeShape="RoundRectangle 20"
              BackgroundColor="#F8F5F0"
              Padding="20"
              HorizontalOptions="Center"
              VerticalOptions="Center">

              <Grid>

                     <VerticalStackLayout Spacing="15"
                                          HorizontalOptions="Fill"
                                          WidthRequest="300">

                            <!-- x:Name="TitleLabel": wird im Code-Behind auf "Termin bearbeiten"
                                 umgestellt, wenn das Popup im Bearbeiten-Modus geöffnet wird
                                 (siehe NewEventPopup.xaml.cs, Konstruktor-Overload mit editingNight). -->
                            <Label x:Name="TitleLabel"
                                   Text="Neuen Termin anlegen"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#3B2E25"/>

                            <!-- Datum/Uhrzeit -->
                            <VerticalStackLayout>
                                   <Border x:Name="DateTimeBorder"
                                           BackgroundColor="#EDE6DD"
                                           Padding="10">
                                          <Border.GestureRecognizers>
                                                 <TapGestureRecognizer Tapped="OnDateTimeTapped"/>
                                          </Border.GestureRecognizers>

                                          <Label x:Name="DateTimeLabel"
                                                 Text="Datum und Uhrzeit wählen"/>
                                   </Border>

                                   <DatePicker x:Name="InlineDatePicker"
                                               IsVisible="False"
                                               Format="dd.MM.yyyy"
                                               DateSelected="OnInlineDateSelected"/>

                                   <TimePicker x:Name="InlineTimePicker"
                                               IsVisible="False"
                                               Format="HH:mm"
                                               TimeSelected="OnInlineTimeChanged"/>
                            </VerticalStackLayout>

                            <!-- Ort (aus locations, LocationId) -->
                            <Picker x:Name="LocationPicker"
                                    Title="Ort wählen"
                                    ItemDisplayBinding="{Binding Name}"
                                    BackgroundColor="#EDE6DD"/>

                            <!-- Spiele (aus games) - Mehrfachauswahl über Checkboxen: ein Tipp auf
                                 GamesFieldBorder öffnet/schließt die Auswahlliste darunter, genau
                                 wie sich bei Ort/Veranstalter der native Picker öffnet. Ausgewählt
                                 wird über CollectionView.SelectionMode="Multiple"; jede Zeile zeigt
                                 zusätzlich ein Kästchen-Symbol (☐/☑), das per VisualStateManager
                                 zwischen den eingebauten Zuständen "Normal"/"Selected" umschaltet -
                                 ganz ohne eigene CheckBox-Controls oder zusätzliches Data Binding.
                                 Für jedes hier ausgewählte Spiel legt EventViewModel beim Speichern
                                 einen eigenen game_suggestions-Eintrag an (siehe AddGameNightAsync/
                                 UpdateGameNightAsync). -->
                            <VerticalStackLayout Spacing="0">
                                   <Border x:Name="GamesFieldBorder"
                                           BackgroundColor="#EDE6DD"
                                           Padding="10">
                                          <Border.GestureRecognizers>
                                                 <TapGestureRecognizer Tapped="OnGamesFieldTapped"/>
                                          </Border.GestureRecognizers>

                                          <Label x:Name="GamesFieldLabel"
                                                 Text="Spiele wählen"
                                                 TextColor="Gray"/>
                                   </Border>

                                   <CollectionView x:Name="GamesCollectionView"
                                                   SelectionMode="Multiple"
                                                   IsVisible="False"
                                                   HeightRequest="140"
                                                   BackgroundColor="#EDE6DD"
                                                   SelectionChanged="OnGamesSelectionChanged">
                                          <CollectionView.ItemTemplate>
                                                 <DataTemplate>
                                                        <Border Margin="4,3"
                                                                Padding="10,8"
                                                                StrokeShape="RoundRectangle 8"
                                                                Stroke="Transparent"
                                                                BackgroundColor="White">

                                                               <VisualStateManager.VisualStateGroups>
                                                                      <VisualStateGroup Name="CommonStates">
                                                                             <VisualState Name="Normal">
                                                                                    <VisualState.Setters>
                                                                                           <Setter TargetName="CheckboxGlyph"
                                                                                                   Property="Label.Text"
                                                                                                   Value="☐"/>
                                                                                    </VisualState.Setters>
                                                                             </VisualState>
                                                                             <VisualState Name="Selected">
                                                                                    <VisualState.Setters>
                                                                                           <Setter TargetName="CheckboxGlyph"
                                                                                                   Property="Label.Text"
                                                                                                   Value="☑"/>
                                                                                    </VisualState.Setters>
                                                                             </VisualState>
                                                                      </VisualStateGroup>
                                                               </VisualStateManager.VisualStateGroups>

                                                               <Grid ColumnDefinitions="Auto,*">
                                                                      <Label x:Name="CheckboxGlyph"
                                                                             Grid.Column="0"
                                                                             Text="☐"
                                                                             FontSize="18"
                                                                             TextColor="#8B5E3C"
                                                                             WidthRequest="28"
                                                                             VerticalOptions="Center"/>

                                                                      <Label Grid.Column="1"
                                                                             Text="{Binding Title}"
                                                                             TextColor="#3B2E25"
                                                                             VerticalOptions="Center"/>
                                                               </Grid>
                                                        </Border>
                                                 </DataTemplate>
                                          </CollectionView.ItemTemplate>
                                   </CollectionView>
                            </VerticalStackLayout>

                            <!-- Veranstalter (aus players, HostPlayerId) -->
                            <Picker x:Name="HostPicker"
                                    Title="Veranstalter wählen"
                                    ItemDisplayBinding="{Binding Name}"
                                    BackgroundColor="#EDE6DD"/>

                            <!-- Zusätzliche freie Notiz (Notes) -->
                            <Entry x:Name="NotesEntry"
                                   Placeholder="Notiz (optional)"
                                   BackgroundColor="#EDE6DD"/>

                            <Button Text="Speichern"
                                    BackgroundColor="#8B5E3C"
                                    TextColor="White"
                                    CornerRadius="12"
                                    Clicked="OnSaveClicked"/>
                     </VerticalStackLayout>

                     <!-- Unsichtbare Picker: dienen nur dazu, über Unfocused-Events (siehe
                          Code-Behind) die native Datum/Uhrzeit-Auswahl anzustoßen, ohne dass
                          diese Picker selbst sichtbar in der Oberfläche auftauchen (Opacity/
                          TranslationX schieben sie praktisch unsichtbar aus dem Bild). -->
                     <DatePicker x:Name="HiddenDatePicker"
                                 Opacity="0.01"
                                 TranslationX="-5000"
                                 WidthRequest="200"
                                 HeightRequest="50"/>

                     <TimePicker x:Name="HiddenTimePicker"
                                 Opacity="0.01"
                                 TranslationX="-5000"
                                 WidthRequest="200"
                                 HeightRequest="50"/>

              </Grid>
       </Border>
</toolkit:Popup>
