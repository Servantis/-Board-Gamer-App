<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="BoardGamerApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BoardGamerApp.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.BackgroundColor="#5B2BEA"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White">

    <!-- Home-Seite -->
    <FlyoutItem Title="Home"
                Route="home">

        <ShellContent Title="Home"
                      Route="main"
                      ContentTemplate="{DataTemplate views:MainPage}" />

    </FlyoutItem>

    <!-- Spieleverwaltung -->
    <FlyoutItem Title="Spiele"
                Route="games">

        <ShellContent Title="Spiele"
                      Route="gameLibrary"
                      ContentTemplate="{DataTemplate views:GameLibrary}" />

    </FlyoutItem>

    <!-- Debug-Bereich: standardmäßig unsichtbar -->
    <FlyoutItem x:Name="DebugFlyoutItem"
                Title="Debug"
                Route="debug"
                IsVisible="False">

        <ShellContent Title="Sync Outbox"
                      Route="syncOutboxDebug"
                      ContentTemplate="{DataTemplate views:SyncOutboxDebugView}" />

    </FlyoutItem>

</Shell>